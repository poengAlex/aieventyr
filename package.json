{
  "name": "bbrguppen.aieventyr",
  "version": "0.0.1",
  "description": "Forbedre og forenkle de norske folkeevntyrene med hjelp av AI",
  "productName": "AI eventyr",
  "author": "Alexander Bjørkmann <bbgruppen@outlook.com>",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "echo \"No test specified\" && exit 0",
    "dev": "quasar dev",
    "build": "quasar build",
    "postinstall": "quasar prepare",
    "pipeline:extract-source": "node pipeline/commands/extract-source.mjs",
    "pipeline:split-stories": "node pipeline/commands/split-stories.mjs",
    "pipeline:generate-cleaned": "node pipeline/commands/generate-cleaned.mjs",
    "pipeline:generate-variants": "node pipeline/commands/generate-variants.mjs",
    "pipeline:generate-variant-characters": "node pipeline/commands/generate-variant-characters.mjs",
    "pipeline:generate-variant-main-image-prompts": "node pipeline/commands/generate-variant-main-image-prompts.mjs",
    "pipeline:generate-variant-character-images": "node pipeline/commands/generate-variant-character-images.mjs",
    "pipeline:generate-variant-main-images": "node pipeline/commands/generate-variant-main-images.mjs",
    "pipeline:generate-variant-audio": "node pipeline/commands/generate-variant-audio.mjs",
    "pipeline:build-inline-scenes": "node pipeline/commands/build-inline-scenes.mjs",
    "pipeline:build-content-manifest": "node pipeline/commands/build-content-manifest.mjs",
    "pipeline:validate": "node pipeline/commands/validate-content.mjs",
    "pipeline:compare-tts-voices": "node pipeline/commands/compare-tts-voices.mjs",
    "pipeline:all": "node pipeline/commands/pipeline-all.mjs",
    "pipeline:all-audio": "node pipeline/commands/pipeline-all-audio.mjs",
    "pipeline:story": "node pipeline/commands/pipeline-story.mjs",
    "pipeline:story-audio": "node pipeline/commands/pipeline-story-audio.mjs",
    "pipeline:variant": "node pipeline/commands/pipeline-variant.mjs",
    "pipeline:variant-audio": "node pipeline/commands/pipeline-variant-audio.mjs"
  },
  "dependencies": {
    "@quasar/extras": "^1.16.4",
    "fluent-ffmpeg": "^2.1.3",
    "pinia": "^2.0.11",
    "pinia-plugin-persistedstate": "^4.2.0",
    "posthog-js": "^1.203.2",
    "quasar": "^2.16.0",
    "sharp": "^0.33.5",
    "vue": "^3.4.18",
    "vue-router": "^4.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@quasar/app-vite": "^2.0.0",
    "@types/node": "^20.5.9",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.1.3",
    "autoprefixer": "^10.4.2",
    "dotenv": "^16.4.7",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^9.30.0",
    "globals": "^15.12.0",
    "openai": "^4.77.0",
    "pdf2pic": "^3.1.3",
    "prettier": "^3.3.3",
    "tesseract.js": "^5.1.1",
    "typescript": "~5.5.3",
    "vite-plugin-checker": "^0.8.0",
    "vue-tsc": "^2.0.29"
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22 || ^20 || ^18",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  }
}
